<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AcademiaSD Krea-2 LoRA Trainer</title>

    <!-- Favicon de la pestaña del navegador -->
    <link rel="icon" type="image/png" href="/assets/logo.png">
    <link rel="shortcut icon" type="image/png" href="/assets/logo.png">

    <style>
        :root {
            --bg-dark: #0f172a;
            --panel-bg: #1e293b;
            --panel-border: #334155;
            --accent: #6366f1;
            --accent-hover: #4f46e5;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg-dark); color: var(--text-main); display: flex; flex-direction: column; min-height: 100vh; padding: 20px; }
        
        header { display: flex; align-items: center; justify-content: space-between; background: var(--panel-bg); padding: 15px 25px; border-radius: 12px; border: 1px solid var(--panel-border); margin-bottom: 20px; gap: 20px; flex-wrap: wrap; }
        .logo-title { display: flex; align-items: center; gap: 15px; }
        .logo-title img { height: 50px; border-radius: 8px; }
        .logo-title h1 { font-size: 1.6rem; font-weight: 800; color: #fff; letter-spacing: -0.5px; }
        .logo-title span { font-size: 0.85rem; color: var(--text-muted); display: block; }

        /* Social Links */
        .social-links { display: flex; gap: 8px; flex-wrap: wrap; }
        .social-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none; color: #fff; background: #0f172a; border: 1px solid var(--panel-border); transition: background 0.2s, border-color 0.2s; }
        .social-btn:hover { border-color: var(--accent); background: #1a2332; }
        .btn-yt { color: #ff0000; }
        .btn-x { color: #f8fafc; }
        .btn-discord { color: #5865f2; }
        .btn-kofi { color: #ff5e5b; }

        /* Hardware Monitor Cards (RAM, VRAM, GPU Temp) */
        .hardware-monitor { display: flex; gap: 12px; }
        .hw-card { background: #0f172a; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--panel-border); min-width: 140px; }
        .hw-card .label { font-size: 0.7rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; }
        .hw-card .value { font-size: 0.95rem; font-weight: bold; margin: 3px 0; color: #38bdf8; }
        .progress-bar-bg { width: 100%; height: 6px; background: #334155; border-radius: 3px; overflow: hidden; }
        .progress-bar-fill { height: 100%; background: var(--accent); width: 0%; transition: width 0.5s ease, background-color 0.5s ease; }

        .main-grid { display: grid; grid-template-columns: 440px 1fr; gap: 20px; flex: 1; }
        .sidebar { display: flex; flex-direction: column; gap: 20px; }
        .panel { background: var(--panel-bg); border-radius: 12px; border: 1px solid var(--panel-border); padding: 20px; }
        .panel-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 15px; color: #f1f5f9; border-bottom: 1px solid var(--panel-border); padding-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }

        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px; font-weight: 500; }
        .form-group input, .form-group select { width: 100%; background: #0f172a; border: 1px solid var(--panel-border); color: #fff; padding: 8px 12px; border-radius: 6px; font-size: 0.9rem; outline: none; }
        .form-group input[readonly] { background: #1a2332; color: #94a3b8; cursor: not-allowed; border-style: dashed; }
        .form-group input:focus, .form-group select:focus { border-color: var(--accent); }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .btn { padding: 9px 14px; border-radius: 6px; font-weight: 600; cursor: pointer; border: none; font-size: 0.88rem; transition: background 0.2s, transform 0.1s; display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; }
        .btn-full { width: 100%; }
        .btn-primary { background: var(--accent); color: white; }
        .btn-primary:hover { background: var(--accent-hover); }
        .btn-success { background: var(--success); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-secondary { background: #334155; color: white; }
        .btn-secondary:hover { background: #475569; }
        .btn-warning { background: var(--warning); color: black; }
        .btn-sm { padding: 4px 10px; font-size: 0.75rem; width: auto; }
        
        .btn-row { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 10px !important; width: 100% !important; box-sizing: border-box !important; }

        .btn-tall { display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; padding: 8px 6px !important; line-height: 1.25 !important; text-align: center !important; min-height: 50px !important; width: 100% !important; box-sizing: border-box !important; }
        .btn-tall .main-text { font-size: 0.85rem; font-weight: 700; color: inherit; }
        .btn-tall .sub-text { font-size: 0.72rem; font-weight: 500; opacity: 0.85; margin-top: 2px; }

        .btn:disabled { opacity: 0.5; cursor: not-allowed; }

        .console-container { display: flex; flex-direction: column; gap: 20px; }
        .terminal { background: #020617; border-radius: 8px; border: 1px solid var(--panel-border); padding: 15px; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.85rem; color: #38bdf8; overflow-y: auto; white-space: pre-wrap; word-break: break-all; height: 320px; }
        .terminal-line { margin-bottom: 2px; line-height: 1.4; }

        .ds-toolbar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; align-items: center; }
        .ds-search { flex: 1; min-width: 150px; background: #0f172a; border: 1px solid var(--panel-border); color: #fff; padding: 6px 10px; border-radius: 6px; font-size: 0.8rem; }
        .ds-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; max-height: 380px; overflow-y: auto; padding-right: 5px; }
        .ds-grid.compact { grid-template-columns: repeat(auto-fill, minmax(95px, 1fr)); }
        .ds-grid.large { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
        .ds-grid.hidden { display: none; }

        .ds-card { background: #0f172a; border: 1px solid var(--panel-border); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; cursor: pointer; transition: transform 0.15s, border-color 0.15s; }
        .ds-card:hover { transform: translateY(-2px); border-color: var(--accent); }
        
        .img-wrapper { position: relative; width: 100%; height: 115px; background: #020617; }
        .ds-grid.compact .img-wrapper { height: 75px; }
        .ds-grid.large .img-wrapper { height: 165px; }
        .img-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; }

        .caption-dot { position: absolute; top: 6px; right: 6px; width: 11px; height: 11px; border-radius: 50%; border: 1.5px solid #0f172a; box-shadow: 0 0 5px rgba(0,0,0,0.8); z-index: 2; }
        .dot-green { background-color: var(--success); }
        .dot-red { background-color: var(--danger); }

        .img-filename-tag { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(2px); padding: 3px 6px; font-size: 0.68rem; color: #f8fafc; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-top: 1px solid rgba(255,255,255,0.05); }
        .ds-card .caption { padding: 6px; font-size: 0.72rem; color: var(--text-muted); height: 40px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.2; background: #0f172a; }

        .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; max-height: 200px; overflow-y: auto; }
        .preview-card { position: relative; border-radius: 6px; overflow: hidden; border: 1px solid var(--panel-border); cursor: pointer; background: #0f172a; transition: transform 0.15s, border-color 0.15s; }
        .preview-card:hover { transform: translateY(-2px); border-color: #38bdf8; }
        .preview-card img { width: 100%; height: 110px; object-fit: cover; display: block; }
        .preview-filename-tag { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(2px); padding: 3px 6px; font-size: 0.68rem; color: #38bdf8; font-weight: 600; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .status-badge { font-size: 0.75rem; padding: 3px 8px; border-radius: 12px; font-weight: bold; text-transform: uppercase; }
        .badge-idle { background: #334155; color: #cbd5e1; }
        .badge-running { background: var(--success); color: #fff; }

        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 1000; justify-content: center; align-items: center; padding: 20px; }
        .modal.active { display: flex; }
        .modal-content { background: var(--panel-bg); border-radius: 12px; border: 1px solid var(--panel-border); max-width: 800px; width: 100%; padding: 20px; display: flex; flex-direction: column; gap: 15px; max-height: 90vh; }
        .modal-content img { max-height: 55vh; object-fit: contain; border-radius: 8px; }
        .modal-content textarea { width: 100%; height: 90px; background: #0f172a; border: 1px solid var(--panel-border); color: #fff; padding: 10px; border-radius: 6px; resize: none; font-size: 0.9rem; }

        .drive-selector { display: flex; gap: 6px; margin-bottom: 8px; flex-wrap: wrap; }
        .dir-list { max-height: 250px; overflow-y: auto; background: #0f172a; border: 1px solid var(--panel-border); border-radius: 6px; padding: 8px; margin-top: 6px; }
        .dir-item { padding: 6px 10px; border-radius: 4px; cursor: pointer; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center; }
        .dir-item:hover { background: #1e293b; color: var(--accent); }
    </style>
</head>
<body>

    <!-- Selector Oculto para Cargar Ficheros JSON -->
    <input type="file" id="json_file_input" accept=".json" style="display:none;" onchange="handleJsonFileLoad(event)">

    <header>
        <div class="logo-title">
            <img src="/assets/logo.png" alt="AcademiaSD Logo" onerror="this.src='/logo.png'; this.onerror=null;">
            <div>
                <h1>AcademiaSD Krea-2 LoRAlab v0.67</h1>
                <span>Web GUI & Automation / Interfaz Web y Automatización</span>
            </div>
        </div>

        <!-- Redes Sociales / Social Links -->
        <div class="social-links">
            <a href="https://www.youtube.com/@Academia_SD" target="_blank" class="social-btn"><span class="btn-yt">▶</span> YouTube</a>
            <a href="https://twitter.com/Academia_S_D" target="_blank" class="social-btn"><span class="btn-x">𝕏</span> X (Twitter)</a>
            <a href="https://discord.gg/Syuaduy678" target="_blank" class="social-btn"><span class="btn-discord">💬</span> Discord</a>
            <a href="https://ko-fi.com/academiasd" target="_blank" class="social-btn"><span class="btn-kofi">☕</span> Ko-Fi</a>
        </div>

        <!-- Hardware Monitor (RAM, VRAM, GPU Temp) -->
        <div class="hardware-monitor">
            <div class="hw-card">
                <div class="label">RAM Usage / Uso RAM</div>
                <div class="value" id="ram-text">-- GB</div>
                <div class="progress-bar-bg"><div class="progress-bar-fill" id="ram-bar"></div></div>
            </div>
            <div class="hw-card">
                <div class="label">VRAM Usage / Uso VRAM</div>
                <div class="value" id="vram-text">-- GB</div>
                <div class="progress-bar-bg"><div class="progress-bar-fill" id="vram-bar" style="background:#38bdf8;"></div></div>
            </div>
            <div class="hw-card">
                <div class="label">GPU Temp / Temp. GPU</div>
                <div class="value" id="gpu-temp-text">-- °C</div>
                <div class="progress-bar-bg"><div class="progress-bar-fill" id="gpu-temp-bar" style="background:var(--success);"></div></div>
            </div>
        </div>
    </header>

    <div class="main-grid">
        <!-- Sidebar: Settings -->
        <div class="sidebar">
            
            <!-- 1. Pre-Cache Settings Panel -->
            <div class="panel">
                <div class="panel-title">1. Pre-Cache Settings / Config. Pre-Caché</div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Project Name / Proyecto:</label>
                        <input type="text" id="project_name" value="" placeholder="Ej: cherry2" oninput="updateProjectPaths()">
                    </div>
                    <div class="form-group">
                        <label>Trigger Word / Palabra Clave:</label>
                        <input type="text" id="trigger_word" value="">
                    </div>
                </div>

                <div class="form-group">
                    <label>Dataset Path / Ruta del Dataset:</label>
                    <div style="display:flex; gap:8px;">
                        <input type="text" id="dataset_path" value="./dataset" onchange="loadDatasetInfo()">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="browseFolderNative('dataset')">Browse / Explorar</button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Cache Folder / Carpeta Caché (Auto):</label>
                    <input type="text" id="precache_cache_dir" value="./cached_data_krea2" readonly title="Ruta informativa generada automáticamente">
                </div>

                <div class="form-group">
                    <label>Resolution / Resolución (px²):</label>
                    <select id="target_area_select" onchange="syncResolution(this.value)">
                        <option value="262144">512 x 512 (262,144 px²)</option>
                        <option value="589824" selected>768 x 768 (589,824 px²)</option>
                        <option value="1048576">1024 x 1024 (1,048,576 px²)</option>
                        <option value="custom">Custom / Personalizada</option>
                    </select>
                    <input type="number" id="precache_target_area" value="589824" style="margin-top:6px; display:none;">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Multiple / Múltiplo:</label>
                        <select id="precache_multiple">
                            <option value="8">8</option>
                            <option value="16" selected>16</option>
                            <option value="32">32</option>
                            <option value="64">64</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Max Side / Lado Máx:</label>
                        <input type="number" id="precache_max_side" value="1280">
                    </div>
                </div>

                <div class="form-group">
                    <label>Max Seq Len / Long. Sec.:</label>
                    <input type="number" id="precache_max_seq_len" value="128">
                </div>

                <!-- Botones Load JSON y Save JSON -->
                <div class="btn-row" style="margin-top:12px;">
                    <button type="button" class="btn btn-secondary btn-tall" onclick="triggerLoadJson('precache')">
                        <span class="main-text">Load JSON</span>
                        <span class="sub-text">Cargar JSON</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-tall" onclick="savePrecacheSettings()">
                        <span class="main-text">Save JSON</span>
                        <span class="sub-text">Guardar JSON</span>
                    </button>
                </div>

                <button type="button" class="btn btn-primary btn-tall btn-full" id="btn-precache" onclick="runPrecache()" style="margin-top:8px;">
                    <span class="main-text">Start Pre-Cache</span>
                    <span class="sub-text">Iniciar Pre-Caché</span>
                </button>
            </div>

            <!-- 2. Training Settings Panel -->
            <div class="panel">
                <div class="panel-title">
                    <span>2. Training Settings / Config. Entrenamiento</span>
                    <span id="checkpoint-badge" style="font-size:0.75rem; color:#38bdf8;"></span>
                </div>
                
                <div class="form-group">
                    <label>Output Dir / Carpeta Salida (Auto):</label>
                    <input type="text" id="train_output_dir" value="./krea2_lora_output" readonly title="Ruta informativa generada automáticamente">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Total Steps / Pasos Totales:</label>
                        <input type="number" id="train_total_steps" value="500">
                    </div>
                    <div class="form-group">
                        <label>Learning Rate / LR:</label>
                        <input type="text" id="train_lr" value="0.0003">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>LoRA Rank (R):</label>
                        <input type="number" id="train_lora_rank" value="16">
                    </div>
                    <div class="form-group">
                        <label>LoRA Alpha (A):</label>
                        <input type="number" id="train_lora_alpha" value="32">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Batch Size:</label>
                        <input type="number" id="train_batch_size" value="1">
                    </div>
                    <div class="form-group">
                        <label>Grad Accum Steps:</label>
                        <input type="number" id="train_grad_accum" value="4">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Save Every / Guardar Cada:</label>
                        <input type="number" id="train_save_every" value="50">
                    </div>
                    <div class="form-group">
                        <label>Seed / Semilla:</label>
                        <input type="number" id="train_seed" value="67">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Preview Every / Preview Cada:</label>
                        <input type="number" id="train_preview_every" value="0">
                    </div>
                    <div class="form-group">
                        <label>Caption Mode / Modo Sample:</label>
                        <select id="train_preview_caption_mode">
                            <option value="first">First / Primero</option>
                            <option value="random">Random / Aleatorio</option>
                            <option value="rotate4">Rotate 4 / Rotar 4</option>
                        </select>
                    </div>
                </div>

                <!-- Botones Load JSON y Save JSON -->
                <div class="btn-row" style="margin-top:12px;">
                    <button type="button" class="btn btn-secondary btn-tall" onclick="triggerLoadJson('train')">
                        <span class="main-text">Load JSON</span>
                        <span class="sub-text">Cargar JSON</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-tall" onclick="saveTrainSettings()">
                        <span class="main-text">Save JSON</span>
                        <span class="sub-text">Guardar JSON</span>
                    </button>
                </div>

                <!-- Botones Start/Resume y Stop -->
                <div class="btn-row" style="margin-top:8px;">
                    <button type="button" class="btn btn-success btn-tall" id="btn-train" onclick="runTrain()">
                        <span class="main-text">Start / Resume</span>
                        <span class="sub-text">Iniciar / Reanudar</span>
                    </button>
                    <button type="button" class="btn btn-danger btn-tall" id="btn-stop" onclick="stopScript()" disabled>
                        <span class="main-text">Stop Training</span>
                        <span class="sub-text">Detener</span>
                    </button>
                </div>
            </div>

            <!-- 3. Export to WebUI Models Panel -->
            <div class="panel">
                <div class="panel-title">3. Export to WebUI / Enviar a Models</div>
                
                <div class="form-group">
                    <label>Final LoRA Filename / Nombre Final (.safetensors):</label>
                    <input type="text" id="export_final_name" value="krea2_lora.safetensors" placeholder="mi_lora_krea2.safetensors">
                </div>

                <div class="form-group">
                    <label>UI LoRA Folder / Carpeta models/lora (ComfyUI / Forge / A1111):</label>
                    <div style="display:flex; gap:8px;">
                        <input type="text" id="export_models_dir" value="" placeholder="C:/ComfyUI/models/loras">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="browseFolderNative('export')">Browse / Explorar</button>
                    </div>
                </div>

                <button type="button" class="btn btn-warning btn-tall btn-full" onclick="sendToModels()" style="margin-top:5px;">
                    <span class="main-text">🚀 Send to Models</span>
                    <span class="sub-text">Enviar a Models</span>
                </button>
            </div>
        </div>

        <!-- Right Column: Terminal, Dataset Inspector & Previews -->
        <div class="panel console-container">
            <div class="panel-title">
                <span>Console Output / Terminal de Consola</span>
                <span class="status-badge badge-idle" id="status-badge">IDLE / INACTIVO</span>
            </div>
            
            <div class="terminal" id="terminal"></div>

            <!-- Dataset Inspector -->
            <div>
                <div class="panel-title">
                    <span>Dataset Inspector / Inspector (<span id="ds-count">0</span> img, <span id="ds-txt-count">0</span> txt)</span>
                    <div class="ds-toolbar">
                        <input type="text" class="ds-search" id="ds-search" placeholder="Search / Buscar..." oninput="filterDatasetGrid()">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setGridMode('compact')">Compact / Pequeño</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setGridMode('normal')">Normal</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setGridMode('large')">Expand / Grande</button>
                        <button type="button" class="btn btn-secondary btn-sm" id="btn-toggle-ds" onclick="toggleDatasetGrid()">Hide / Ocultar</button>
                        <button type="button" class="btn btn-warning btn-sm" onclick="addTriggerToAllCaptions()">+ Trigger All</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="loadDatasetInfo()">Refresh / Actualizar</button>
                    </div>
                </div>
                <div class="ds-grid" id="ds-grid"></div>
            </div>

            <!-- Previews -->
            <div>
                <div class="panel-title">Generated Step Previews / Previsualizaciones Generadas</div>
                <div class="gallery" id="gallery"></div>
            </div>
        </div>
    </div>

    <!-- Modal: Edit Caption & Inspection -->
    <div class="modal" id="modal" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <h3 id="modal-filename" style="font-size:1rem;">Filename</h3>
                <span style="font-size:0.8rem; color:var(--text-muted);">Click outside or button to close</span>
            </div>
            <img id="modal-img" src="" alt="Dataset Image">
            <div class="form-group">
                <label>Caption Text (.txt):</label>
                <textarea id="modal-txt"></textarea>
            </div>
            <div style="display:flex; gap:10px;">
                <button type="button" class="btn btn-success btn-full" onclick="saveCurrentCaption()">Save Caption / Guardar Caption</button>
                <button type="button" class="btn btn-secondary btn-full" onclick="closeModal()">Close / Cerrar</button>
            </div>
        </div>
    </div>

    <!-- Modal: Folder Browser Backup -->
    <div class="modal" id="folder-modal" onclick="closeFolderModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()" style="max-width:600px;">
            <h3>Select Directory / Seleccionar Carpeta</h3>
            <div style="font-size:0.85rem; color:var(--text-muted);" id="browser-current-path">/</div>
            
            <div class="drive-selector" id="drive-selector"></div>
            <div class="dir-list" id="dir-list"></div>

            <div style="display:flex; gap:10px; margin-top:10px;">
                <button type="button" class="btn btn-primary btn-full" onclick="confirmFolderSelection()">Use Selected Folder / Usar Carpeta</button>
                <button type="button" class="btn btn-secondary btn-full" onclick="closeFolderModal()">Cancel / Cancelar</button>
            </div>
        </div>
    </div>

    <script>
        let allDatasetImages = [];
        let currentEditingFilename = '';
        let browserPath = '';
        let currentBrowserTarget = 'dataset';
        let currentLoadTarget = 'precache';

        async function updateSystemStats() {
            try {
                const res = await fetch('/api/system-stats');
                const data = await res.json();
                document.getElementById('ram-text').innerText = `${data.ram.used_gb} / ${data.ram.total_gb} GB`;
                document.getElementById('ram-bar').style.width = `${data.ram.percent}%`;
                document.getElementById('vram-text').innerText = `${data.vram.used_gb} / ${data.vram.total_gb} GB`;
                document.getElementById('vram-bar').style.width = `${data.vram.percent}%`;

                // Monitor Temperatura GPU (°C)
                const temp = data.vram.temp_c || 0;
                document.getElementById('gpu-temp-text').innerText = temp ? `${temp} °C` : 'N/A';
                
                const tempBar = document.getElementById('gpu-temp-bar');
                const tempPct = Math.min(100, Math.max(0, (temp / 100) * 100));
                tempBar.style.width = `${tempPct}%`;

                if (temp >= 80) {
                    tempBar.style.backgroundColor = 'var(--danger)';
                } else if (temp >= 70) {
                    tempBar.style.backgroundColor = 'var(--warning)';
                } else {
                    tempBar.style.backgroundColor = 'var(--success)';
                }
            } catch (e) {}
        }
        setInterval(updateSystemStats, 3000);
        updateSystemStats();

        function updateProjectPaths() {
            const proj = document.getElementById('project_name').value.trim();
            const cacheDir = proj ? `./cached_data_krea2_${proj}` : './cached_data_krea2';
            const outputDir = proj ? `./krea2_lora_output_${proj}` : './krea2_lora_output';
            
            document.getElementById('precache_cache_dir').value = cacheDir;
            document.getElementById('train_output_dir').value = outputDir;
            
            if (proj) {
                document.getElementById('export_final_name').value = `krea2_lora_${proj}.safetensors`;
            }
            checkCheckpointInfo();
        }

        function syncResolution(val) {
            const customInput = document.getElementById('precache_target_area');
            if (val === 'custom') {
                customInput.style.display = 'block';
            } else {
                customInput.style.display = 'none';
                customInput.value = val;
            }
        }

        async function loadSettings() {
            try {
                const res = await fetch('/api/settings');
                const data = await res.json();
                if (data.pre_cache) {
                    const p = data.pre_cache;
                    if (p.project_name) document.getElementById('project_name').value = p.project_name;
                    if (p.trigger_word) document.getElementById('trigger_word').value = p.trigger_word;
                    if (p.dataset_path) document.getElementById('dataset_path').value = p.dataset_path;
                    if (p.target_area) {
                        document.getElementById('precache_target_area').value = p.target_area;
                        const sel = document.getElementById('target_area_select');
                        if (['262144', '589824', '1048576'].includes(String(p.target_area))) {
                            sel.value = String(p.target_area);
                        } else {
                            sel.value = 'custom';
                            document.getElementById('precache_target_area').style.display = 'block';
                        }
                    }
                    if (p.multiple) document.getElementById('precache_multiple').value = p.multiple;
                    if (p.max_side) document.getElementById('precache_max_side').value = p.max_side;
                    if (p.max_seq_len) document.getElementById('precache_max_seq_len').value = p.max_seq_len;
                }
                if (data.train) {
                    const t = data.train;
                    if (t.total_steps) document.getElementById('train_total_steps').value = t.total_steps;
                    if (t.lr) document.getElementById('train_lr').value = t.lr;
                    if (t.lora_rank) document.getElementById('train_lora_rank').value = t.lora_rank;
                    if (t.lora_alpha) document.getElementById('train_lora_alpha').value = t.lora_alpha;
                    if (t.batch_size) document.getElementById('train_batch_size').value = t.batch_size;
                    if (t.grad_accum_steps) document.getElementById('train_grad_accum').value = t.grad_accum_steps;
                    if (t.save_every) document.getElementById('train_save_every').value = t.save_every;
                    if (t.seed) document.getElementById('train_seed').value = t.seed;
                    if (t.preview_every) document.getElementById('train_preview_every').value = t.preview_every;
                    if (t.preview_caption_mode) document.getElementById('train_preview_caption_mode').value = t.preview_caption_mode;
                    if (t.export_models_dir) document.getElementById('export_models_dir').value = t.export_models_dir;
                    if (t.export_final_name) document.getElementById('export_final_name').value = t.export_final_name;
                }
                updateProjectPaths();
                loadDatasetInfo();
            } catch (e) {}
        }
        loadSettings();

        // CARGAR FICHERO JSON
        function triggerLoadJson(target) {
            currentLoadTarget = target;
            document.getElementById('json_file_input').click();
        }

        function handleJsonFileLoad(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    
                    if (data.project_name !== undefined) document.getElementById('project_name').value = data.project_name;
                    if (data.trigger_word !== undefined) document.getElementById('trigger_word').value = data.trigger_word;
                    if (data.dataset_path !== undefined) document.getElementById('dataset_path').value = data.dataset_path;
                    
                    if (data.target_area !== undefined) {
                        document.getElementById('precache_target_area').value = data.target_area;
                        const sel = document.getElementById('target_area_select');
                        if (['262144', '589824', '1048576'].includes(String(data.target_area))) {
                            sel.value = String(data.target_area);
                            document.getElementById('precache_target_area').style.display = 'none';
                        } else {
                            sel.value = 'custom';
                            document.getElementById('precache_target_area').style.display = 'block';
                        }
                    }
                    if (data.multiple !== undefined) document.getElementById('precache_multiple').value = data.multiple;
                    if (data.max_side !== undefined) document.getElementById('precache_max_side').value = data.max_side;
                    if (data.max_seq_len !== undefined) document.getElementById('precache_max_seq_len').value = data.max_seq_len;
                    
                    if (data.total_steps !== undefined) document.getElementById('train_total_steps').value = data.total_steps;
                    if (data.lr !== undefined) document.getElementById('train_lr').value = data.lr;
                    if (data.lora_rank !== undefined) document.getElementById('train_lora_rank').value = data.lora_rank;
                    if (data.lora_alpha !== undefined) document.getElementById('train_lora_alpha').value = data.lora_alpha;
                    if (data.batch_size !== undefined) document.getElementById('train_batch_size').value = data.batch_size;
                    if (data.grad_accum_steps !== undefined) document.getElementById('train_grad_accum').value = data.grad_accum_steps;
                    if (data.save_every !== undefined) document.getElementById('train_save_every').value = data.save_every;
                    if (data.seed !== undefined) document.getElementById('train_seed').value = data.seed;
                    if (data.preview_every !== undefined) document.getElementById('train_preview_every').value = data.preview_every;
                    if (data.preview_caption_mode !== undefined) document.getElementById('train_preview_caption_mode').value = data.preview_caption_mode;
                    if (data.export_models_dir !== undefined) document.getElementById('export_models_dir').value = data.export_models_dir;
                    if (data.export_final_name !== undefined) document.getElementById('export_final_name').value = data.export_final_name;

                    updateProjectPaths();
                    
                    if (currentLoadTarget === 'precache') {
                        await savePrecacheSettings();
                    } else if (currentLoadTarget === 'train') {
                        await saveTrainSettings();
                    }

                    alert(`✓ Configuration loaded / Configuración cargada desde:\n${file.name}`);
                    loadDatasetInfo();
                } catch (err) {
                    alert(`[!] JSON Error / Error al leer JSON: ${err}`);
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        async function browseFolderNative(target) {
            currentBrowserTarget = target;
            let currentPath = '';
            if (target === 'dataset') currentPath = document.getElementById('dataset_path').value;
            else if (target === 'export') currentPath = document.getElementById('export_models_dir').value;

            try {
                const res = await fetch('/api/select-folder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ initial_dir: currentPath })
                });
                const data = await res.json();
                
                if (data.status === 'ok' && data.path) {
                    if (target === 'dataset') {
                        document.getElementById('dataset_path').value = data.path;
                        loadDatasetInfo();
                    } else if (target === 'export') {
                        document.getElementById('export_models_dir').value = data.path;
                    }
                } else if (data.status === 'error') {
                    openFolderBrowserWeb(target, currentPath);
                }
            } catch (e) {
                openFolderBrowserWeb(target, currentPath);
            }
        }

        async function savePrecacheSettings() {
            const proj = document.getElementById('project_name').value.trim();
            const precacheData = {
                project_name: proj,
                trigger_word: document.getElementById('trigger_word').value,
                dataset_path: document.getElementById('dataset_path').value,
                target_area: parseInt(document.getElementById('precache_target_area').value),
                multiple: parseInt(document.getElementById('precache_multiple').value),
                max_side: parseInt(document.getElementById('precache_max_side').value),
                max_seq_len: parseInt(document.getElementById('precache_max_seq_len').value),
                cache_dir: document.getElementById('precache_cache_dir').value
            };
            const res = await fetch('/api/save-precache', { method: 'POST', body: JSON.stringify(precacheData) });
            const data = await res.json();
            if (data.status === 'ok') {
                const listStr = data.all_saved ? data.all_saved.join('\n • ') : data.file;
                alert(`✓ Pre-Cache Settings saved / Configuración Pre-Caché guardada en:\n • ${listStr}`);
            }
        }

        async function saveTrainSettings() {
            const proj = document.getElementById('project_name').value.trim();
            const trainData = {
                project_name: proj,
                trigger_word: document.getElementById('trigger_word').value,
                dataset_path: document.getElementById('dataset_path').value,
                cache_dir: document.getElementById('precache_cache_dir').value,
                output_dir: document.getElementById('train_output_dir').value,
                total_steps: parseInt(document.getElementById('train_total_steps').value),
                lr: parseFloat(document.getElementById('train_lr').value),
                lora_rank: parseInt(document.getElementById('train_lora_rank').value),
                lora_alpha: parseInt(document.getElementById('train_lora_alpha').value),
                batch_size: parseInt(document.getElementById('train_batch_size').value),
                grad_accum_steps: parseInt(document.getElementById('train_grad_accum').value),
                save_every: parseInt(document.getElementById('train_save_every').value),
                seed: parseInt(document.getElementById('train_seed').value),
                preview_every: parseInt(document.getElementById('train_preview_every').value),
                preview_caption_mode: document.getElementById('train_preview_caption_mode').value,
                export_models_dir: document.getElementById('export_models_dir').value,
                export_final_name: document.getElementById('export_final_name').value
            };
            const res = await fetch('/api/save-train', { method: 'POST', body: JSON.stringify(trainData) });
            const data = await res.json();
            if (data.status === 'ok') {
                const listStr = data.all_saved ? data.all_saved.join('\n • ') : data.file;
                alert(`✓ Train Settings saved / Configuración de Entrenamiento guardada en:\n • ${listStr}`);
            }
        }

        async function checkCheckpointInfo() {
            try {
                const res = await fetch('/api/checkpoint-info');
                const data = await res.json();
                const badge = document.getElementById('checkpoint-badge');
                if (data.has_checkpoint) {
                    badge.innerText = `[Resume Step / Paso ${data.current_step}]`;
                } else {
                    badge.innerText = '[New / Nuevo]';
                }
            } catch (e) {}
        }

        function appendTerminal(text, replace = false) {
            const term = document.getElementById('terminal');
            if (replace && term.lastElementChild) {
                term.lastElementChild.innerText = text;
            } else {
                const div = document.createElement('div');
                div.className = 'terminal-line';
                div.innerText = text;
                term.appendChild(div);
            }
            term.scrollTop = term.scrollHeight;
        }

        async function startScript(scriptName) {
            document.getElementById('terminal').innerHTML = '';
            appendTerminal(`[SYSTEM] Launching / Iniciando ${scriptName}...`);
            setRunningState(true);

            try {
                const response = await fetch('/api/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ script: scriptName })
                });

                const reader = response.body.getReader();
                const decoder = new TextDecoder('utf-8');
                let buffer = '';

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    buffer += decoder.decode(value, { stream: true });

                    const lines = buffer.split('\n\n');
                    buffer = lines.pop();

                    for (const line of lines) {
                        if (line.startsWith('data: ')) {
                            try {
                                const msg = JSON.parse(line.slice(6));
                                if (msg.type === 'output') {
                                    appendTerminal(msg.text, msg.replace);
                                } else if (msg.type === 'done') {
                                    appendTerminal(`\n[SYSTEM] Finished with code / Finalizado con código: ${msg.code}`);
                                }
                            } catch (e) {}
                        }
                    }
                }
            } catch (err) {
                appendTerminal(`\n[SYSTEM] Execution error / Error de ejecución: ${err}`);
            } finally {
                setRunningState(false);
                loadPreviews();
                checkCheckpointInfo();
            }
        }

        async function runPrecache() {
            await savePrecacheSettings();
            startScript('precache');
        }

        async function runTrain() {
            await saveTrainSettings();
            startScript('train');
        }

        async function stopScript() {
            appendTerminal('\n[SYSTEM] Sending stop signal... / Enviando señal de detención...');
            await fetch('/api/stop', { method: 'POST' });
        }

        async function sendToModels() {
            const targetDir = document.getElementById('export_models_dir').value.trim();
            const finalName = document.getElementById('export_final_name').value.trim();

            if (!targetDir) {
                alert('Please select or enter a target Models directory / Por favor selecciona la carpeta destino models/lora.');
                return;
            }

            appendTerminal(`\n[SYSTEM] Exporting LoRA model to / Exportando LoRA a: ${targetDir}...`);

            try {
                const res = await fetch('/api/export-lora', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ target_dir: targetDir, final_name: finalName })
                });
                const data = await res.json();
                if (data.status === 'ok') {
                    alert(`✓ LoRA exported successfully / LoRA exportado con éxito:\n${data.filename}\n\nCopied from / Copiado desde: ${data.source}`);
                    appendTerminal(`[SYSTEM] ✓ Export completed / Exportación completada: ${data.dest}`);
                } else {
                    alert(`[!] Export Error / Error de exportación: ${data.error}`);
                    appendTerminal(`[SYSTEM] [!] Export failed: ${data.error}`);
                }
            } catch (e) {
                alert(`[!] Network Error / Error de red: ${e}`);
            }
        }

        function setRunningState(running) {
            document.getElementById('btn-precache').disabled = running;
            document.getElementById('btn-train').disabled = running;
            document.getElementById('btn-stop').disabled = !running;
            
            const badge = document.getElementById('status-badge');
            if (running) {
                badge.className = 'status-badge badge-running';
                badge.innerText = 'RUNNING / EN EJECUCIÓN';
            } else {
                badge.className = 'status-badge badge-idle';
                badge.innerText = 'IDLE / INACTIVO';
            }
        }

        async function loadDatasetInfo() {
            try {
                const res = await fetch('/api/dataset-info');
                const data = await res.json();
                allDatasetImages = data.images || [];
                document.getElementById('ds-count').innerText = data.image_count;
                document.getElementById('ds-txt-count').innerText = data.caption_count;
                renderDatasetGrid(allDatasetImages);
            } catch (e) {}
        }

        function renderDatasetGrid(images) {
            const grid = document.getElementById('ds-grid');
            grid.innerHTML = '';
            images.forEach(img => {
                const card = document.createElement('div');
                card.className = 'ds-card';
                card.onclick = () => openModal(`/api/dataset-image/${img.file}`, img.file, img.caption || '');
                
                const hasCaption = img.has_txt && img.caption && img.caption.trim().length > 0;
                const dotClass = hasCaption ? 'caption-dot dot-green' : 'caption-dot dot-red';
                const dotTitle = hasCaption ? 'Caption OK / Texto existente' : 'No Caption / Sin texto';

                card.innerHTML = `
                    <div class="img-wrapper">
                        <img src="/api/dataset-image/${img.file}" alt="${img.file}">
                        <span class="${dotClass}" title="${dotTitle}"></span>
                        <div class="img-filename-tag">${img.file}</div>
                    </div>
                    <div class="caption">${img.caption || '<em>No .txt caption / Sin texto</em>'}</div>
                `;
                grid.appendChild(card);
            });
        }

        function filterDatasetGrid() {
            const q = document.getElementById('ds-search').value.toLowerCase();
            const filtered = allDatasetImages.filter(img => 
                img.file.toLowerCase().includes(q) || (img.caption && img.caption.toLowerCase().includes(q))
            );
            renderDatasetGrid(filtered);
        }

        function setGridMode(mode) {
            const grid = document.getElementById('ds-grid');
            grid.classList.remove('compact', 'large', 'hidden');
            if (mode === 'compact') grid.classList.add('compact');
            if (mode === 'large') grid.classList.add('large');
            document.getElementById('btn-toggle-ds').innerText = 'Hide / Ocultar';
        }

        function toggleDatasetGrid() {
            const grid = document.getElementById('ds-grid');
            const btn = document.getElementById('btn-toggle-ds');
            if (grid.classList.contains('hidden')) {
                grid.classList.remove('hidden');
                btn.innerText = 'Hide / Ocultar';
            } else {
                grid.classList.add('hidden');
                btn.innerText = 'Show / Mostrar';
            }
        }

        async function addTriggerToAllCaptions() {
            const trigger = document.getElementById('trigger_word').value;
            if (!trigger) {
                alert('Please enter a Trigger Word first / Por favor ingresa una palabra clave primero.');
                return;
            }
            if (confirm(`Add trigger "${trigger}" to all dataset captions? / ¿Añadir palabra clave a todos los captions?`)) {
                await fetch('/api/batch-caption', {
                    method: 'POST',
                    body: JSON.stringify({ trigger_word: trigger })
                });
                loadDatasetInfo();
            }
        }

        async function loadPreviews() {
            try {
                const res = await fetch('/api/previews');
                const data = await res.json();
                const gallery = document.getElementById('gallery');
                gallery.innerHTML = '';
                data.previews.forEach(filename => {
                    const card = document.createElement('div');
                    card.className = 'preview-card';
                    card.onclick = () => openModal(`/api/preview/${filename}`, filename, `Generated preview / Previsualización: ${filename}`);

                    let stepTag = filename;
                    const match = filename.match(/preview_step_(\d+)\.png/i);
                    if (match) {
                        stepTag = `Step / Paso ${match[1]}`;
                    }

                    card.innerHTML = `
                        <img src="/api/preview/${filename}" alt="${filename}">
                        <div class="preview-filename-tag">${stepTag}</div>
                    `;
                    gallery.appendChild(card);
                });
            } catch (e) {}
        }
        setInterval(loadPreviews, 8000);
        loadPreviews();

        function openModal(imgSrc, filename, text) {
            currentEditingFilename = filename;
            document.getElementById('modal-filename').innerText = filename;
            document.getElementById('modal-img').src = imgSrc;
            document.getElementById('modal-txt').value = text;
            document.getElementById('modal').classList.add('active');
        }

        function closeModal(e) {
            document.getElementById('modal').classList.remove('active');
        }

        async function saveCurrentCaption() {
            const newCaption = document.getElementById('modal-txt').value;
            const res = await fetch('/api/save-caption', {
                method: 'POST',
                body: JSON.stringify({ filename: currentEditingFilename, caption: newCaption })
            });
            const data = await res.json();
            if (data.status === 'ok') {
                alert('✓ Caption saved / Caption guardado!');
                closeModal();
                loadDatasetInfo();
            }
        }

        async function openFolderBrowserWeb(target = 'dataset', path = '') {
            currentBrowserTarget = target;
            if (!path) {
                if (target === 'dataset') path = document.getElementById('dataset_path').value;
                else if (target === 'export') path = document.getElementById('export_models_dir').value;
            }
            const res = await fetch(`/api/browse-dir?path=${encodeURIComponent(path)}`);
            const data = await res.json();
            
            browserPath = data.current_path;
            document.getElementById('browser-current-path').innerText = `${browserPath} (${data.image_count} images inside)`;
            
            const driveSel = document.getElementById('drive-selector');
            driveSel.innerHTML = '';
            if (data.drives && data.drives.length > 0) {
                data.drives.forEach(drv => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-secondary btn-sm';
                    btn.innerText = `💾 ${drv}`;
                    btn.onclick = () => openFolderBrowserWeb(target, drv);
                    driveSel.appendChild(btn);
                });
            }

            const dirList = document.getElementById('dir-list');
            dirList.innerHTML = '';

            const parentDiv = document.createElement('div');
            parentDiv.className = 'dir-item';
            parentDiv.innerHTML = `<strong>📁 .. [Up / Subir]</strong>`;
            parentDiv.onclick = () => openFolderBrowserWeb(target, data.parent_path);
            dirList.appendChild(parentDiv);

            data.directories.forEach(d => {
                const item = document.createElement('div');
                item.className = 'dir-item';
                item.innerHTML = `<span>📁 ${d.name}</span>`;
                item.onclick = () => openFolderBrowserWeb(target, d.path);
                dirList.appendChild(item);
            });

            document.getElementById('folder-modal').classList.add('active');
        }

        function confirmFolderSelection() {
            if (currentBrowserTarget === 'dataset') {
                document.getElementById('dataset_path').value = browserPath;
                loadDatasetInfo();
            } else if (currentBrowserTarget === 'export') {
                document.getElementById('export_models_dir').value = browserPath;
            }
            closeFolderModal();
        }

        function closeFolderModal(e) {
            document.getElementById('folder-modal').classList.remove('active');
        }
    </script>
</body>
</html>