<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AcademiaSD — Krea-2 LoRA Trainer</title>

<style>
:root {
    --bg: #0b0d11;
    --panel: #12151b;
    --panel2: #181c24;
    --border: #292e38;
    --text: #e8ebf0;
    --muted: #8d95a3;
    --accent: #7c5cff;
    --accent2: #9a83ff;
    --green: #42d392;
    --red: #ff5f6d;
    --orange: #ffb454;
    --input: #0d1015;
    --shadow: 0 15px 50px rgba(0,0,0,.35);
}

* {
    box-sizing: border-box;
}

html {
    min-height: 100%;
}

body {
    margin: 0;
    min-height: 100vh;
    background:
        radial-gradient(
            circle at 20% 0%,
            rgba(124,92,255,.12),
            transparent 35%
        ),
        var(--bg);
    color: var(--text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

button,
input,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

.header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    padding: 0 28px;
    background: rgba(11,13,17,.88);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
}

.brand {
    display: flex;
    align-items: center;
    gap: 14px;
}

.logo {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--accent), #4f36c7);
    box-shadow: 0 8px 30px rgba(124,92,255,.3);
}

.logo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
}

.brand-title {
    font-weight: 800;
    font-size: 17px;
}

.brand-subtitle {
    color: var(--muted);
    font-size: 12px;
    margin-top: 2px;
}

.status {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--panel);
    color: var(--muted);
    font-size: 12px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
}

.status.running {
    color: var(--green);
}

.status.running .status-dot {
    background: var(--green);
    box-shadow: 0 0 12px var(--green);
}

.status.error {
    color: var(--red);
}

.status.error .status-dot {
    background: var(--red);
}

.container {
    width: min(1500px, calc(100% - 40px));
    margin: 0 auto;
    padding: 28px 0 60px;
}

.grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
}

.card {
    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.018),
            rgba(255,255,255,0)
        ),
        var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
}

.card.full {
    grid-column: 1 / -1;
}

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
}

.card-title {
    font-size: 15px;
    font-weight: 800;
}

.card-description {
    color: var(--muted);
    font-size: 12px;
    margin-top: 4px;
    line-height: 1.5;
}

.card-body {
    padding: 20px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
}

.field {
    min-width: 0;
}

.field.full {
    grid-column: 1 / -1;
}

label {
    display: block;
    margin-bottom: 7px;
    color: #b7bec9;
    font-size: 12px;
    font-weight: 700;
}

input,
select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--input);
    color: var(--text);
    outline: none;
    transition:
        border-color .15s,
        box-shadow .15s;
}

input:focus,
select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(124,92,255,.13);
}

.input-hint {
    margin-top: 5px;
    color: var(--muted);
    font-size: 11px;
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
}

button {
    border: 0;
    border-radius: 9px;
    padding: 10px 15px;
    color: white;
    font-weight: 750;
    font-size: 12px;
    transition:
        transform .12s,
        opacity .12s,
        filter .12s;
}

button:hover {
    filter: brightness(1.08);
}

button:active {
    transform: translateY(1px);
}

button:disabled {
    cursor: not-allowed;
    opacity: .45;
}

.btn-primary {
    background: var(--accent);
}

.btn-success {
    background: #188d5b;
}

.btn-danger {
    background: #a92f3e;
}

.btn-secondary {
    background: #292e38;
}

.btn-warning {
    background: #9a681f;
}

.console {
    height: 420px;
    padding: 15px;
    overflow: auto;
    background: #07090c;
    color: #bfc7d4;
    font-family:
        "Cascadia Code",
        "Consolas",
        monospace;
    font-size: 12px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
}

.console-line {
    margin: 0;
}

.console-line.system {
    color: var(--accent2);
}

.console-line.success {
    color: var(--green);
}

.console-line.error {
    color: var(--red);
}

.console-line.warning {
    color: var(--orange);
}

.dataset-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 15px;
}

.stat {
    padding: 14px;
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: 10px;
}

.stat-value {
    font-size: 20px;
    font-weight: 850;
}

.stat-label {
    margin-top: 3px;
    color: var(--muted);
    font-size: 11px;
}

.dataset-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-bottom: 15px;
}

.dataset-toolbar .toolbar-spacer {
    flex: 1;
}

.dataset-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    transition:
        grid-template-columns .2s ease,
        opacity .2s ease;
}

.dataset-grid.expanded {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.dataset-grid.collapsed {
    grid-template-columns: repeat(6, minmax(0, 1fr));
}

.dataset-grid.hidden {
    display: none;
}

.dataset-item {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #07090c;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    transition:
        transform .15s,
        border-color .15s,
        box-shadow .15s;
}

.dataset-item:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 10px 30px rgba(0,0,0,.35);
}

.dataset-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.dataset-caption-status {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 3;
    padding: 5px 8px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .2px;
    backdrop-filter: blur(8px);
}

.dataset-caption-status.ok {
    color: #07150f;
    background: var(--green);
    box-shadow: 0 4px 15px rgba(66,211,146,.25);
}

.dataset-caption-status.missing {
    color: white;
    background: var(--red);
    box-shadow: 0 4px 15px rgba(255,95,109,.25);
}

.dataset-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 42px 10px 10px;
    background:
        linear-gradient(
            to top,
            rgba(0,0,0,.92),
            rgba(0,0,0,.72) 48%,
            transparent
        );
    pointer-events: none;
}

.dataset-filename {
    color: white;
    font-size: 11px;
    font-weight: 750;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dataset-caption {
    color: #d9dee7;
    font-size: 10px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
}

.dataset-grid.expanded .dataset-caption {
    -webkit-line-clamp: 10;
}

.dataset-grid.collapsed .dataset-caption {
    -webkit-line-clamp: 2;
}

.path-box {
    padding: 10px 12px;
    margin-bottom: 15px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--input);
    color: var(--muted);
    font-family: monospace;
    font-size: 11px;
    word-break: break-all;
}

.preview-section {
    position: relative;
}

.preview-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
}

.preview-slider {
    flex: 1;
    min-width: 100px;
}

.preview-page {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
}

.preview-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
}

.preview {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #07090c;
    cursor: pointer;
    transition:
        transform .15s,
        border-color .15s;
}

.preview:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
}

.preview img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.preview-label {
    position: absolute;
    left: 7px;
    right: 7px;
    bottom: 7px;
    padding: 5px 7px;
    border-radius: 6px;
    background: rgba(0,0,0,.72);
    color: white;
    font-family: monospace;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 30px;
    background: rgba(0,0,0,.88);
    backdrop-filter: blur(10px);
}

.modal.open {
    display: flex;
}

.modal-content {
    position: relative;
    max-width: min(1100px, 95vw);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.modal-image {
    max-width: 95vw;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 20px 80px rgba(0,0,0,.6);
}

.modal-caption {
    max-width: 900px;
    max-height: 120px;
    overflow: auto;
    padding: 10px 14px;
    border-radius: 9px;
    background: rgba(18,21,27,.95);
    border: 1px solid var(--border);
    color: #dfe4ec;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
}

.modal-close {
    position: absolute;
    top: -15px;
    right: -15px;
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: 50%;
    background: #292e38;
    font-size: 20px;
    line-height: 38px;
}

@media (max-width: 1200px) {
    .dataset-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .dataset-grid.expanded {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dataset-grid.collapsed {
        grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .preview-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}

@media (max-width: 1000px) {
    .grid {
        grid-template-columns: 1fr;
    }

    .card.full {
        grid-column: auto;
    }

    .dataset-grid,
    .dataset-grid.expanded {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dataset-grid.collapsed {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .preview-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    .container {
        width: min(100% - 20px, 1500px);
    }

    .header {
        padding: 0 15px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .field.full {
        grid-column: auto;
    }

    .dataset-grid,
    .dataset-grid.expanded,
    .dataset-grid.collapsed {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .preview-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dataset-info {
        grid-template-columns: 1fr;
    }

    .card-header {
        align-items: flex-start;
        flex-direction: column;
    }
}
</style>
</head>

<body>

<header class="header">
    <div class="brand">
        <div class="logo">
            <img
                src="/logo.png"
                alt="AcademiaSD"
                onerror="this.style.display='none';"
            >
        </div>

        <div>
            <div class="brand-title">
                AcademiaSD — Krea-2 LoRA Trainer
            </div>

            <div class="brand-subtitle">
                Pre-cache · Training · Previews
            </div>
        </div>
    </div>

    <div id="status" class="status">
        <span class="status-dot"></span>
        <span id="statusText">Server ready</span>
    </div>
</header>

<main class="container">

<div class="grid">

<section class="card">

    <div class="card-header">
        <div>
            <div class="card-title">
                1 · Dataset Pre-cache
            </div>

            <div class="card-description">
                Configuration for generating latents and embeddings.<br>
                Configuración para generar latentes y embeddings.
            </div>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid">

            <div class="field">
                <label for="pc_model_id">
                    Model / Modelo
                </label>

                <input
                    id="pc_model_id"
                    type="text"
                    value="Krea-2-NF4"
                >
            </div>

            <div class="field">
                <label for="pc_dataset_path">
                    Dataset / Dataset
                </label>

                <input
                    id="pc_dataset_path"
                    type="text"
                    value="./dataset"
                >
            </div>

            <div class="field">
                <label for="pc_cache_dir">
                    Cache Folder / Carpeta de Caché
                </label>

                <input
                    id="pc_cache_dir"
                    type="text"
                    value="cached_data_krea2"
                >
            </div>

            <div class="field">
                <label for="pc_project_name">
                    Project Name / Nombre de Proyecto
                </label>

                <input
                    id="pc_project_name"
                    type="text"
                    value=""
                >
            </div>

            <div class="field">
                <label for="pc_target_area">
                    Target Area / Área Objetivo
                </label>

                <select id="pc_target_area">
                    <option value="262144">512 × 512</option>
                    <option value="589824">768 × 768</option>
                    <option value="1048576">1024 × 1024</option>
                </select>
            </div>

            <div class="field">
                <label for="pc_max_side">
                    Maximum Side / Lado Máximo
                </label>

                <input
                    id="pc_max_side"
                    type="number"
                    min="16"
                    step="16"
                    value="1280"
                >
            </div>

            <div class="field">
                <label for="pc_multiple">
                    Multiple / Múltiplo
                </label>

                <select id="pc_multiple">
                    <option value="8">8</option>
                    <option value="16" selected>16</option>
                    <option value="32">32</option>
                    <option value="64">64</option>
                    <option value="128">128</option>
                    <option value="256">256</option>
                    <option value="512">512</option>
                    <option value="1024">1024</option>
                </select>
            </div>

            <div class="field">
                <label for="pc_max_seq_len">
                    Maximum Text Length / Máxima Longitud de Texto
                </label>

                <input
                    id="pc_max_seq_len"
                    type="number"
                    min="1"
                    step="1"
                    value="128"
                >
            </div>

        </div>

        <div class="actions">

            <button
                class="btn-primary"
                id="savePrecacheBtn"
                onclick="savePrecache()"
            >
                Save Configuration / Guardar Configuración
            </button>

            <button
                class="btn-success"
                id="runPrecacheBtn"
                onclick="runScript('precache')"
            >
                Run Pre-cache / Ejecutar Pre-cache
            </button>

            <button
                class="btn-secondary"
                onclick="loadDatasetInfo()"
            >
                Refresh Dataset / Actualizar Dataset
            </button>

        </div>

    </div>

</section>

<section class="card">

    <div class="card-header">

        <div>
            <div class="card-title">
                2 · LoRA Training / Entrenamiento LoRA
            </div>

            <div class="card-description">
                Complete Krea-2 training configuration.<br>
                Configuración completa del entrenamiento Krea-2.
            </div>
        </div>

    </div>

    <div class="card-body">

        <div class="form-grid">

            <div class="field">
                <label for="tr_model_id">
                    Model / Modelo
                </label>

                <input
                    id="tr_model_id"
                    type="text"
                    value="Krea-2-NF4"
                >
            </div>

            <div class="field">
                <label for="tr_project_name">
                    Project Name / Nombre de Proyecto
                </label>

                <input
                    id="tr_project_name"
                    type="text"
                    value=""
                >
            </div>

            <div class="field">
                <label for="tr_cache_dir">
                    Cache / Caché
                </label>

                <input
                    id="tr_cache_dir"
                    type="text"
                    value="cached_data_krea2"
                >
            </div>

            <div class="field">
                <label for="tr_output_dir">
                    LoRA Output / Salida LoRA
                </label>

                <input
                    id="tr_output_dir"
                    type="text"
                    value="krea2_lora_output"
                >
            </div>

            <div class="field">
                <label for="tr_total_steps">
                    Total Steps / Pasos Totales
                </label>

                <input
                    id="tr_total_steps"
                    type="number"
                    min="1"
                    step="1"
                    value="1200"
                >
            </div>

            <div class="field">
                <label for="tr_batch_size">
                    Batch Size
                </label>

                <input
                    id="tr_batch_size"
                    type="number"
                    min="1"
                    step="1"
                    value="1"
                >
            </div>

            <div class="field">
                <label for="tr_grad_accum_steps">
                    Gradient Accumulation / Acumulación de Gradiente
                </label>

                <input
                    id="tr_grad_accum_steps"
                    type="number"
                    min="1"
                    step="1"
                    value="4"
                >
            </div>

            <div class="field">
                <label for="tr_lr">
                    Learning Rate / Tasa de Aprendizaje
                </label>

                <input
                    id="tr_lr"
                    type="number"
                    min="0"
                    step="0.000001"
                    value="0.0003"
                >
            </div>

            <div class="field">
                <label for="tr_min_lr_ratio">
                    Min LR Ratio / Ratio LR Mínimo
                </label>

                <input
                    id="tr_min_lr_ratio"
                    type="number"
                    min="0"
                    max="1"
                    step="0.01"
                    value="0.1"
                >
            </div>

            <div class="field">
                <label for="tr_warmup_steps">
                    Warmup Steps / Pasos de Calentamiento
                </label>

                <input
                    id="tr_warmup_steps"
                    type="number"
                    min="0"
                    step="1"
                    value="100"
                >
            </div>

            <div class="field">
                <label for="tr_lora_rank">
                    LoRA Rank
                </label>

                <input
                    id="tr_lora_rank"
                    type="number"
                    min="8"
                    max="512"
                    step="1"
                    value="16"
                >
            </div>

            <div class="field">
                <label for="tr_lora_alpha">
                    LoRA Alpha
                </label>

                <input
                    id="tr_lora_alpha"
                    type="number"
                    min="1"
                    step="1"
                    value="32"
                >
            </div>

            <div class="field">
                <label for="tr_weight_decay">
                    Weight Decay / Decaimiento de Peso
                </label>

                <input
                    id="tr_weight_decay"
                    type="number"
                    min="0"
                    step="0.0001"
                    value="0"
                >
            </div>

            <div class="field">
                <label for="tr_max_grad_norm">
                    Max Grad Norm / Norma Máxima de Gradiente
                </label>

                <input
                    id="tr_max_grad_norm"
                    type="number"
                    min="0"
                    step="0.1"
                    value="1"
                >
            </div>

            <div class="field">
                <label for="tr_save_every">
                    Save Every N Steps / Guardar Cada N Pasos
                </label>

                <input
                    id="tr_save_every"
                    type="number"
                    min="1"
                    step="1"
                    value="25"
                >
            </div>

            <div class="field">
                <label for="tr_seed">
                    Seed / Semilla
                </label>

                <input
                    id="tr_seed"
                    type="number"
                    step="1"
                    value="42"
                >
            </div>

            <div class="field">
                <label for="tr_timestep_sampling">
                    Timestep Sampling / Muestreo de Timestep
                </label>

                <select id="tr_timestep_sampling">
                    <option value="krea2_shift">krea2_shift</option>
                    <option value="logit_normal">logit_normal</option>
                </select>
            </div>

            <div class="field">
                <label for="tr_preview_every">
                    Preview Every N Steps / Preview Cada N Pasos
                </label>

                <input
                    id="tr_preview_every"
                    type="number"
                    min="0"
                    step="1"
                    value="0"
                >
            </div>

            <div class="field">
                <label for="tr_preview_steps">
                    Preview Steps / Pasos de Preview
                </label>

                <input
                    id="tr_preview_steps"
                    type="number"
                    min="1"
                    step="1"
                    value="28"
                >
            </div>

            <div class="field">
                <label for="tr_preview_cfg">
                    Preview CFG
                </label>

                <input
                    id="tr_preview_cfg"
                    type="number"
                    min="0"
                    step="0.1"
                    value="3.5"
                >
            </div>

            <div class="field">
                <label for="tr_preview_caption_mode">
                    Preview Caption Mode / Modo de Caption para Preview
                </label>

                <select id="tr_preview_caption_mode">
                    <option value="first">First caption / Primer caption</option>
                    <option value="random">Random caption / Caption aleatorio</option>
                    <option value="rotate4">Rotate first 4 / Rotar primeros 4</option>
                </select>

                <div class="input-hint">
                    Which dataset caption to use for training previews.<br>
                    Qué caption del dataset usar para los previews de entrenamiento.
                </div>
            </div>

        </div>

        <div class="actions">

            <button
                class="btn-primary"
                id="saveTrainBtn"
                onclick="saveTrain()"
            >
                Save Configuration / Guardar Configuración
            </button>

            <button
                class="btn-success"
                id="runTrainBtn"
                onclick="runScript('train')"
            >
                Start Training / Iniciar Entrenamiento
            </button>

            <button
                class="btn-danger"
                id="stopBtn"
                onclick="stopScript()"
                disabled
            >
                Stop Process / Detener Proceso
            </button>

        </div>

    </div>

</section>

<section class="card full">

    <div class="card-header">

        <div>
            <div class="card-title">
                Dataset
            </div>

            <div class="card-description">
                Selected dataset images and captions. Click an image to view it larger.<br>
                Imágenes y captions del dataset seleccionado. Pulsa una imagen para verla en grande.
            </div>
        </div>

        <button
            class="btn-secondary"
            onclick="loadDatasetInfo()"
        >
            Refresh / Actualizar
        </button>

    </div>

    <div class="card-body">

        <div
            id="datasetPath"
            class="path-box"
        >
            Loading... / Cargando...
        </div>

        <div class="dataset-info">

            <div class="stat">
                <div
                    id="imageCount"
                    class="stat-value"
                >
                    0
                </div>

                <div class="stat-label">
                    Images / Imágenes
                </div>
            </div>

            <div class="stat">
                <div
                    id="captionCount"
                    class="stat-value"
                >
                    0
                </div>

                <div class="stat-label">
                    Captions / Captions
                </div>
            </div>

            <div class="stat">
                <div
                    id="missingCount"
                    class="stat-value"
                >
                    0
                </div>

                <div class="stat-label">
                    Missing Captions / Sin Caption
                </div>
            </div>

        </div>

        <div class="dataset-toolbar">

            <button
                class="btn-secondary"
                onclick="expandAllDataset()"
            >
                Expand All / Expandir Todo
            </button>

            <button
                class="btn-secondary"
                onclick="collapseAllDataset()"
            >
                Collapse All / Colapsar Todo
            </button>

            <button
                class="btn-secondary"
                id="toggleDatasetBtn"
                onclick="toggleDatasetVisibility()"
            >
                Close Dataset / Cerrar Dataset
            </button>

            <div class="toolbar-spacer"></div>

            <span
                id="datasetVisibleCount"
                class="preview-page"
            >
                0 images / 0 imágenes
            </span>

        </div>

        <div
            id="datasetGrid"
            class="dataset-grid"
        >
            <div class="empty">
                Loading dataset... / Cargando dataset...
            </div>
        </div>

    </div>

</section>

<section class="card full">

    <div class="card-header">

        <div>
            <div class="card-title">
                Generation Outputs / Resultados de Generación
            </div>

            <div class="card-description">
                Latest images generated during training. Click an image to view it larger.<br>
                Últimas imágenes generadas durante el entrenamiento. Pulsa una imagen para verla en grande.
            </div>
        </div>

        <button
            class="btn-secondary"
            onclick="loadPreviews()"
        >
            Refresh / Actualizar
        </button>

    </div>

    <div class="card-body preview-section">

        <div
            id="previewPath"
            class="path-box"
        >
            Loading... / Cargando...
        </div>

        <div class="preview-toolbar">

            <button
                class="btn-secondary"
                onclick="previousPreviewPage()"
            >
                ←
            </button>

            <input
                id="previewSlider"
                class="preview-slider"
                type="range"
                min="0"
                max="0"
                value="0"
                step="1"
                oninput="previewSliderChanged()"
            >

            <button
                class="btn-secondary"
                onclick="nextPreviewPage()"
            >
                →
            </button>

            <span
                id="previewPage"
                class="preview-page"
            >
                0 / 0
            </span>

        </div>

        <div
            id="previewGrid"
            class="preview-grid"
        >
            <div class="empty">
                No previews available yet. / No hay previews disponibles todavía.
            </div>
        </div>

    </div>

</section>

<section class="card full">

    <div class="card-header">

        <div>
            <div class="card-title">
                Console / Consola
            </div>

            <div class="card-description">
                Real-time Python process output.<br>
                Salida en tiempo real del proceso Python.
            </div>
        </div>

        <button
            class="btn-secondary"
            onclick="clearConsole()"
        >
            Clear / Limpiar
        </button>

    </div>

    <div
        id="console"
        class="console"
    ></div>

</section>

</div>

</main>

<div
    id="imageModal"
    class="modal"
    onclick="closeImageModal(event)"
>
    <div class="modal-content">

        <button
            class="modal-close"
            onclick="closeImageModal()"
        >
            ×
        </button>

        <img
            id="modalImage"
            class="modal-image"
            src=""
            alt=""
        >

        <div
            id="modalCaption"
            class="modal-caption"
        ></div>

    </div>
</div>

<script>

let eventSource = null;
let currentScript = null;
let previewTimer = null;
let statusTimer = null;

let datasetItems = [];

let datasetViewMode = "normal";
let datasetIsOpen = true;

let previewItems = [];
let previewPageIndex = 0;

const PREVIEWS_PER_PAGE = 12;


// ================================================================
// UTILITIES
// ================================================================

function $(id) {
    return document.getElementById(id);
}


function numberValue(id) {

    const value = Number($(id).value);

    return Number.isFinite(value)
        ? value
        : 0;
}


function addConsole(text, type = "") {

    const consoleElement = $("console");

    const line =
        document.createElement("div");

    line.className =
        "console-line " + type;

    line.textContent =
        text;

    consoleElement.appendChild(line);

    consoleElement.scrollTop =
        consoleElement.scrollHeight;
}


function clearConsole() {
    $("console").innerHTML = "";
}


function setStatus(text, state = "") {

    const status =
        $("status");

    status.className =
        "status " + state;

    $("statusText").textContent =
        text;
}


async function api(url, options = {}) {

    const response =
        await fetch(
            url,
            {
                cache: "no-store",
                ...options
            }
        );

    let data = {};

    try {
        data = await response.json();
    } catch (_) {
        data = {};
    }

    if (!response.ok) {

        throw new Error(
            data.error ||
            `HTTP ${response.status}`
        );
    }

    return data;
}


// ================================================================
// PROJECT NAME
// ================================================================

function sanitizeProjectName(value) {

    return String(value || "")
        .trim()
        .replace(
            /[<>:"/\\|?*\x00-\x1F]/g,
            "_"
        )
        .replace(
            /\s+/g,
            "_"
        );
}


function syncProjectFields(source) {

    let value = "";

    if (source === "pc") {
        value = $("pc_project_name").value;
    } else {
        value = $("tr_project_name").value;
    }

    const project =
        sanitizeProjectName(value);

    $("pc_project_name").value =
        project;

    $("tr_project_name").value =
        project;

    if (project) {

        $("pc_cache_dir").value =
            `cached_data_krea2_${project}`;

        $("tr_cache_dir").value =
            `cached_data_krea2_${project}`;

        $("tr_output_dir").value =
            `krea2_lora_output_${project}`;
    }
}


$("pc_project_name").addEventListener(
    "input",
    function() {
        syncProjectFields("pc");
    }
);


$("tr_project_name").addEventListener(
    "input",
    function() {
        syncProjectFields("tr");
    }
);


// ================================================================
// LOAD SETTINGS
// ================================================================

async function loadSettings() {

    try {

        const data =
            await api("/api/settings");

        const pc =
            data.pre_cache || {};

        const tr =
            data.train || {};

        $("pc_model_id").value =
            pc.model_id ??
            tr.model_id ??
            "Krea-2-NF4";

        $("pc_dataset_path").value =
            pc.dataset_path ??
            "./dataset";

        $("pc_cache_dir").value =
            pc.cache_dir ??
            "cached_data_krea2";

        $("pc_target_area").value =
            String(
                pc.target_area ??
                262144
            );

        $("pc_max_side").value =
            pc.max_side ??
            1280;

        $("pc_multiple").value =
            String(
                pc.multiple ??
                16
            );

        $("pc_max_seq_len").value =
            pc.max_seq_len ??
            128;

        $("pc_project_name").value =
            pc.project_name ??
            pc.trigger_word ??
            "";

        $("tr_model_id").value =
            tr.model_id ??
            pc.model_id ??
            "Krea-2-NF4";

        $("tr_project_name").value =
            tr.project_name ??
            tr.trigger_word ??
            pc.project_name ??
            pc.trigger_word ??
            "";

        $("tr_cache_dir").value =
            tr.cache_dir ??
            pc.cache_dir ??
            "cached_data_krea2";

        $("tr_output_dir").value =
            tr.output_dir ??
            "krea2_lora_output";

        $("tr_total_steps").value =
            tr.total_steps ??
            1200;

        $("tr_batch_size").value =
            tr.batch_size ??
            1;

        $("tr_grad_accum_steps").value =
            tr.grad_accum_steps ??
            4;

        $("tr_lr").value =
            tr.lr ??
            0.0003;

        $("tr_min_lr_ratio").value =
            tr.min_lr_ratio ??
            0.1;

        $("tr_warmup_steps").value =
            tr.warmup_steps ??
            100;

        $("tr_lora_rank").value =
            tr.lora_rank ??
            16;

        $("tr_lora_alpha").value =
            tr.lora_alpha ??
            32;

        $("tr_weight_decay").value =
            tr.weight_decay ??
            0;

        $("tr_max_grad_norm").value =
            tr.max_grad_norm ??
            1;

        $("tr_save_every").value =
            tr.save_every ??
            25;

        $("tr_seed").value =
            tr.seed ??
            42;

        $("tr_timestep_sampling").value =
            tr.timestep_sampling ??
            "krea2_shift";

        $("tr_preview_every").value =
            tr.preview_every ??
            0;

        $("tr_preview_steps").value =
            tr.preview_steps ??
            28;

        $("tr_preview_cfg").value =
            tr.preview_cfg ??
            3.5;

        $("tr_preview_caption_mode").value =
            tr.preview_caption_mode ??
            "first";

        syncProjectFields("pc");

        setStatus(
            "Settings loaded / Configuración cargada"
        );

    } catch (error) {

        addConsole(
            "[ERROR] Failed loading settings / Error cargando configuración: " +
            error.message,
            "error"
        );

        setStatus(
            "Settings error / Error de configuración",
            "error"
        );
    }
}


// ================================================================
// PRE-CACHE
// ================================================================

function getPrecacheConfig() {

    const project =
        sanitizeProjectName(
            $("pc_project_name").value
        );

    return {

        model_id:
            $("pc_model_id").value.trim(),

        dataset_path:
            $("pc_dataset_path").value.trim(),

        cache_dir:
            $("pc_cache_dir").value.trim(),

        target_area:
            numberValue("pc_target_area"),

        max_side:
            numberValue("pc_max_side"),

        multiple:
            numberValue("pc_multiple"),

        max_seq_len:
            numberValue("pc_max_seq_len"),

        project_name:
            project,

        trigger_word:
            project
    };
}


async function savePrecache() {

    try {

        syncProjectFields("pc");

        const config =
            getPrecacheConfig();

        await api(
            "/api/save-precache",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body:
                    JSON.stringify(config)
            }
        );

        addConsole(
            "[OK] Pre-cache settings saved / Configuración de pre-cache guardada.",
            "success"
        );

    } catch (error) {

        addConsole(
            "[ERROR] " +
            error.message,
            "error"
        );
    }
}


// ================================================================
// TRAINING
// ================================================================

function getTrainConfig() {

    const project =
        sanitizeProjectName(
            $("tr_project_name").value
        );

    return {

        model_id:
            $("tr_model_id").value.trim(),

        cache_dir:
            $("tr_cache_dir").value.trim(),

        output_dir:
            $("tr_output_dir").value.trim(),

        total_steps:
            numberValue("tr_total_steps"),

        batch_size:
            numberValue("tr_batch_size"),

        grad_accum_steps:
            numberValue("tr_grad_accum_steps"),

        lr:
            numberValue("tr_lr"),

        min_lr_ratio:
            numberValue("tr_min_lr_ratio"),

        warmup_steps:
            numberValue("tr_warmup_steps"),

        lora_rank:
            Math.min(
                512,
                Math.max(
                    8,
                    numberValue("tr_lora_rank")
                )
            ),

        lora_alpha:
            numberValue("tr_lora_alpha"),

        weight_decay:
            numberValue("tr_weight_decay"),

        max_grad_norm:
            numberValue("tr_max_grad_norm"),

        save_every:
            numberValue("tr_save_every"),

        seed:
            numberValue("tr_seed"),

        timestep_sampling:
            $("tr_timestep_sampling").value,

        preview_every:
            numberValue("tr_preview_every"),

        preview_steps:
            numberValue("tr_preview_steps"),

        preview_cfg:
            numberValue("tr_preview_cfg"),

        preview_caption_mode:
            $("tr_preview_caption_mode").value,

        project_name:
            project,

        trigger_word:
            project
    };
}


async function saveTrain() {

    try {

        syncProjectFields("tr");

        const config =
            getTrainConfig();

        await api(
            "/api/save-train",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body:
                    JSON.stringify(config)
            }
        );

        addConsole(
            "[OK] Training settings saved / Configuración de entrenamiento guardada.",
            "success"
        );

    } catch (error) {

        addConsole(
            "[ERROR] " +
            error.message,
            "error"
        );
    }
}


// ================================================================
// PROCESS
// ================================================================

async function runScript(script) {

    if (currentScript) {

        addConsole(
            "[WARN] A process is already running / Ya hay un proceso ejecutándose.",
            "warning"
        );

        return;
    }

    try {

        if (script === "precache") {
            await savePrecache();
        } else if (script === "train") {
            await saveTrain();
        }

        clearConsole();

        addConsole(
            "============================================================",
            "system"
        );

        addConsole(
            script === "precache"
                ? "STARTING PRE-CACHE / INICIANDO PRE-CACHE"
                : "STARTING TRAINING / INICIANDO ENTRENAMIENTO",
            "system"
        );

        addConsole(
            "============================================================",
            "system"
        );

        const response =
            await fetch(
                "/api/run",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            script
                        })
                }
            );

        if (!response.ok) {

            let errorData = {};

            try {
                errorData =
                    await response.json();
            } catch (_) {}

            throw new Error(
                errorData.error ||
                `HTTP ${response.status}`
            );
        }

        currentScript =
            script;

        updateButtons();

        setStatus(
            script === "precache"
                ? "Pre-cache running / Pre-cache ejecutándose"
                : "Training running / Entrenamiento ejecutándose",
            "running"
        );

        const reader =
            response.body.getReader();

        const decoder =
            new TextDecoder("utf-8");

        let buffer = "";

        while (true) {

            const {
                value,
                done
            } =
                await reader.read();

            if (done) {
                break;
            }

            buffer +=
                decoder.decode(
                    value,
                    {
                        stream: true
                    }
                );

            const events =
                buffer.split("\n\n");

            buffer =
                events.pop() || "";

            for (const event of events) {

                const line =
                    event
                        .split("\n")
                        .find(
                            line =>
                                line.startsWith(
                                    "data:"
                                )
                        );

                if (!line) {
                    continue;
                }

                const payload =
                    line
                        .slice(5)
                        .trim();

                if (!payload) {
                    continue;
                }

                let message;

                try {
                    message =
                        JSON.parse(
                            payload
                        );
                } catch (_) {
                    continue;
                }

                handleProcessMessage(
                    message
                );
            }
        }

        currentScript =
            null;

        updateButtons();

        await refreshStatus();

        await loadPreviews();

    } catch (error) {

        currentScript =
            null;

        updateButtons();

        setStatus(
            "Error / Error",
            "error"
        );

        addConsole(
            "[ERROR] " +
            error.message,
            "error"
        );
    }
}


function handleProcessMessage(message) {

    if (message.type === "start") {

        addConsole(
            `[START] ${message.script}`,
            "system"
        );

        addConsole(
            `Python: ${message.python}`,
            "system"
        );

        addConsole(
            `CWD: ${message.cwd}`,
            "system"
        );

        return;
    }

    if (message.type === "output") {

        const text =
            message.text || "";

        let type = "";

        if (
            text.includes("[ERROR]") ||
            text.includes("Traceback") ||
            text.includes("Error:")
        ) {

            type = "error";

        } else if (
            text.includes("[OK]") ||
            text.includes("finished") ||
            text.includes("finalized")
        ) {

            type = "success";

        } else if (
            text.includes("WARN") ||
            text.includes("WARNING") ||
            text.includes("⚠")
        ) {

            type = "warning";
        }

        addConsole(
            text,
            type
        );

        return;
    }

    if (message.type === "done") {

        const success =
            Number(message.code) === 0;

        addConsole(
            success
                ? `[OK] Process finished correctly / Proceso finalizado correctamente. Code / Código: ${message.code}`
                : `[ERROR] Process ended with code / El proceso terminó con código: ${message.code}`,
            success
                ? "success"
                : "error"
        );

        setStatus(
            success
                ? "Process finished / Proceso finalizado"
                : "Process error / Proceso con errores",
            success
                ? ""
                : "error"
        );

        currentScript =
            null;

        updateButtons();

        loadPreviews();
    }
}


// ================================================================
// STOP
// ================================================================

async function stopScript() {

    try {

        const data =
            await api(
                "/api/stop",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            script:
                                currentScript
                        })
                }
            );

        addConsole(
            `[STOP] ${data.status} / ${data.status}`,
            "warning"
        );

    } catch (error) {

        addConsole(
            "[ERROR] " +
            error.message,
            "error"
        );
    }
}


// ================================================================
// BUTTONS
// ================================================================

function updateButtons() {

    const running =
        Boolean(currentScript);

    $("runPrecacheBtn").disabled =
        running;

    $("runTrainBtn").disabled =
        running;

    $("stopBtn").disabled =
        !running;

    $("savePrecacheBtn").disabled =
        running;

    $("saveTrainBtn").disabled =
        running;
}


// ================================================================
// STATUS
// ================================================================

async function refreshStatus() {

    try {

        const data =
            await api(
                "/api/status"
            );

        if (data.running) {

            currentScript =
                data.script;

            setStatus(
                data.script === "precache"
                    ? "Pre-cache running / Pre-cache ejecutándose"
                    : "Training running / Entrenamiento ejecutándose",
                "running"
            );

        } else {

            if (currentScript) {
                currentScript = null;
            }

            setStatus(
                "Server ready / Servidor listo"
            );
        }

        updateButtons();

    } catch (error) {

        setStatus(
            "Server unavailable / Servidor no disponible",
            "error"
        );
    }
}


// ================================================================
// DATASET VIEW CONTROLS
// ================================================================

function setDatasetViewMode(mode) {

    datasetViewMode =
        mode;

    const grid =
        $("datasetGrid");

    grid.classList.remove(
        "expanded",
        "collapsed"
    );

    if (mode === "expanded") {

        grid.classList.add(
            "expanded"
        );

    } else if (mode === "collapsed") {

        grid.classList.add(
            "collapsed"
        );
    }
}


function expandAllDataset() {

    if (!datasetIsOpen) {
        return;
    }

    setDatasetViewMode(
        "expanded"
    );
}


function collapseAllDataset() {

    if (!datasetIsOpen) {
        return;
    }

    setDatasetViewMode(
        "collapsed"
    );
}


function toggleDatasetVisibility() {

    const grid =
        $("datasetGrid");

    datasetIsOpen =
        !datasetIsOpen;

    if (datasetIsOpen) {

        grid.classList.remove(
            "hidden"
        );

        $("toggleDatasetBtn").textContent =
            "Close Dataset / Cerrar Dataset";

    } else {

        grid.classList.add(
            "hidden"
        );

        $("toggleDatasetBtn").textContent =
            "Open Dataset / Abrir Dataset";
    }
}


// ================================================================
// DATASET
// ================================================================

function createDatasetImageUrl(filename) {

    return (
        "/api/dataset-image/" +
        encodeURIComponent(filename) +
        "?t=" +
        Date.now()
    );
}


function renderDataset() {

    const grid =
        $("datasetGrid");

    grid.innerHTML = "";

    grid.classList.remove(
        "expanded",
        "collapsed",
        "hidden"
    );

    if (datasetViewMode === "expanded") {

        grid.classList.add(
            "expanded"
        );

    } else if (datasetViewMode === "collapsed") {

        grid.classList.add(
            "collapsed"
        );
    }

    if (!datasetIsOpen) {

        grid.classList.add(
            "hidden"
        );
    }

    if (!datasetItems.length) {

        grid.innerHTML =
            `<div class="empty">
                No images found. / No se encontraron imágenes.
            </div>`;

        $("datasetVisibleCount").textContent =
            "0 images / 0 imágenes";

        return;
    }

    for (const image of datasetItems) {

        const item =
            document.createElement("div");

        item.className =
            "dataset-item";

        item.onclick =
            function() {

                openImageModal(
                    createDatasetImageUrl(
                        image.file
                    ),
                    image.caption ||
                    image.file
                );
            };

        const img =
            document.createElement("img");

        img.className =
            "dataset-image";

        img.src =
            createDatasetImageUrl(
                image.file
            );

        img.alt =
            image.file;

        img.loading =
            "lazy";

        img.onerror =
            function() {

                this.style.display =
                    "none";

                item.style.background =
                    "#1a1d24";
            };

        const status =
            document.createElement("div");

        status.className =
            "dataset-caption-status " +
            (
                image.has_txt
                    ? "ok"
                    : "missing"
            );

        status.textContent =
            image.has_txt
                ? "CAPTION OK"
                : "NO CAPTION";

        const overlay =
            document.createElement("div");

        overlay.className =
            "dataset-overlay";

        const filename =
            document.createElement("div");

        filename.className =
            "dataset-filename";

        filename.textContent =
            image.file;

        const caption =
            document.createElement("div");

        caption.className =
            "dataset-caption";

        caption.textContent =
            image.caption ||
            (
                image.has_txt
                    ? "Caption available / Caption disponible"
                    : "No caption / Sin caption"
            );

        overlay.appendChild(
            filename
        );

        overlay.appendChild(
            caption
        );

        item.appendChild(
            img
        );

        item.appendChild(
            status
        );

        item.appendChild(
            overlay
        );

        grid.appendChild(
            item
        );
    }

    $("datasetVisibleCount").textContent =
        `${datasetItems.length} images / ${datasetItems.length} imágenes`;

    $("toggleDatasetBtn").textContent =
        datasetIsOpen
            ? "Close Dataset / Cerrar Dataset"
            : "Open Dataset / Abrir Dataset";
}


async function loadDatasetInfo() {

    try {

        const data =
            await api(
                "/api/dataset-info"
            );

        $("datasetPath").textContent =
            data.path ||
            "No dataset / Sin dataset";

        const images =
            data.images ||
            [];

        datasetItems =
            images;

        const imageCount =
            Number(
                data.image_count ||
                images.length
            );

        const captionCount =
            Number(
                data.caption_count ||
                images.filter(
                    item =>
                        item.has_txt
                ).length
            );

        $("imageCount").textContent =
            imageCount;

        $("captionCount").textContent =
            captionCount;

        $("missingCount").textContent =
            Math.max(
                0,
                imageCount -
                captionCount
            );

        renderDataset();

    } catch (error) {

        $("datasetGrid").innerHTML =
            `<div class="empty">
                Error loading dataset / Error cargando dataset:
                ${escapeHtml(error.message)}
            </div>`;
    }
}


// ================================================================
// PREVIEWS
// ================================================================

async function loadPreviews() {

    try {

        const data =
            await api(
                "/api/previews"
            );

        $("previewPath").textContent =
            data.output_dir ||
            "No output folder / Sin carpeta de salida";

        previewItems =
            data.previews ||
            [];

        const totalPages =
            Math.max(
                1,
                Math.ceil(
                    previewItems.length /
                    PREVIEWS_PER_PAGE
                )
            );

        if (
            previewPageIndex >=
            totalPages
        ) {

            previewPageIndex =
                totalPages - 1;
        }

        $("previewSlider").max =
            Math.max(
                0,
                totalPages - 1
            );

        $("previewSlider").value =
            previewPageIndex;

        renderPreviewPage();

    } catch (error) {

        $("previewGrid").innerHTML =
            `<div class="empty">
                Error loading previews / Error cargando previews.
            </div>`;
    }
}


function renderPreviewPage() {

    const grid =
        $("previewGrid");

    grid.innerHTML = "";

    if (!previewItems.length) {

        grid.innerHTML =
            `<div class="empty">
                No previews available yet. / No hay previews disponibles todavía.
            </div>`;

        $("previewPage").textContent =
            "0 / 0";

        return;
    }

    const totalPages =
        Math.ceil(
            previewItems.length /
            PREVIEWS_PER_PAGE
        );

    const start =
        previewPageIndex *
        PREVIEWS_PER_PAGE;

    const pageItems =
        previewItems.slice(
            start,
            start +
            PREVIEWS_PER_PAGE
        );

    for (const filename of pageItems) {

        const wrapper =
            document.createElement(
                "div"
            );

        wrapper.className =
            "preview";

        const img =
            document.createElement(
                "img"
            );

        const src =
            "/api/preview/" +
            encodeURIComponent(
                filename
            ) +
            "?t=" +
            Date.now();

        img.src =
            src;

        img.loading =
            "lazy";

        img.alt =
            filename;

        wrapper.onclick =
            function() {

                openImageModal(
                    src,
                    filename
                );
            };

        const label =
            document.createElement(
                "div"
            );

        label.className =
            "preview-label";

        label.textContent =
            filename;

        wrapper.appendChild(
            img
        );

        wrapper.appendChild(
            label
        );

        grid.appendChild(
            wrapper
        );
    }

    $("previewPage").textContent =
        `${previewPageIndex + 1} / ${totalPages}`;
}


function previousPreviewPage() {

    if (!previewItems.length) {
        return;
    }

    previewPageIndex =
        Math.max(
            0,
            previewPageIndex - 1
        );

    $("previewSlider").value =
        previewPageIndex;

    renderPreviewPage();
}


function nextPreviewPage() {

    if (!previewItems.length) {
        return;
    }

    const totalPages =
        Math.ceil(
            previewItems.length /
            PREVIEWS_PER_PAGE
        );

    previewPageIndex =
        Math.min(
            totalPages - 1,
            previewPageIndex + 1
        );

    $("previewSlider").value =
        previewPageIndex;

    renderPreviewPage();
}


function previewSliderChanged() {

    previewPageIndex =
        Number(
            $("previewSlider").value
        ) || 0;

    renderPreviewPage();
}


// ================================================================
// IMAGE MODAL
// ================================================================

function openImageModal(src, caption) {

    $("modalImage").src =
        src;

    $("modalImage").alt =
        caption || "";

    $("modalCaption").textContent =
        caption || "";

    $("imageModal").classList.add(
        "open"
    );
}


function closeImageModal(event) {

    if (
        event &&
        event.target !==
        $("imageModal")
    ) {
        return;
    }

    $("imageModal").classList.remove(
        "open"
    );

    $("modalImage").src =
        "";
}


document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key ===
            "Escape"
        ) {

            $("imageModal").classList.remove(
                "open"
            );
        }
    }
);


// ================================================================
// ESCAPE HTML
// ================================================================

function escapeHtml(value) {

    return String(value)
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );
}


// ================================================================
// INITIALIZATION
// ================================================================

async function initialize() {

    addConsole(
        "[SYSTEM] AcademiaSD Krea-2 Trainer started / iniciado.",
        "system"
    );

    addConsole(
        "[SYSTEM] JSON files are saved next to the server / Los archivos JSON se guardan junto al servidor.",
        "system"
    );

    await loadSettings();

    await loadDatasetInfo();

    await loadPreviews();

    await refreshStatus();

    if (statusTimer) {

        clearInterval(
            statusTimer
        );
    }

    statusTimer =
        setInterval(
            refreshStatus,
            3000
        );

    if (previewTimer) {

        clearInterval(
            previewTimer
        );
    }

    previewTimer =
        setInterval(
            loadPreviews,
            10000
        );
}


window.addEventListener(
    "DOMContentLoaded",
    initialize
);

</script>

</body>
</html>